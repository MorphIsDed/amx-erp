datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  HR
  FINANCE
  MANAGER
  EMPLOYEE
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
  TERMINATED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  PARTIALLY_PAID
  OVERDUE
  CANCELLED
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
  SYSTEM
}

enum NotificationChannel {
  IN_APP
  EMAIL
  WEBHOOK
}

enum DeliveryStatus {
  PENDING
  DELIVERED
  FAILED
  RETRYING
}

enum StockMovementType {
  IN
  OUT
  ADJUSTMENT
  TRANSFER
}

enum PurchaseOrderStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  ORDERED
  RECEIVED
  PARTIALLY_RECEIVED
  CANCELLED
}

enum PayrollStatus {
  DRAFT
  PROCESSING
  COMPLETED
  CANCELLED
}

enum PayslipStatus {
  PENDING
  PAID
  FAILED
}

model Tenant {
  id        String   @id @default(uuid())
  name      String
  domain    String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users        User[]
  employees    Employee[]
  departments  Department[]
  invoices     Invoice[]
  transactions Transaction[]

  notifications Notification[]
  activityLogs  ActivityLog[]

  vendors        Vendor[]
  warehouses     Warehouse[]
  products       Product[]
  stockMovements StockMovement[]
  purchaseOrders PurchaseOrder[]

  payrollRuns         PayrollRun[]
  payslips            Payslip[]
  WebhookSubscription WebhookSubscription[]

  accounts            Account[]
  journalEntries      JournalEntry[]
  accountingPeriods   AccountingPeriod[]
  leaves              Leave[]
}

model User {
  id       String  @id @default(uuid())
  email    String  @unique
  password String
  name     String?
  role     Role    @default(EMPLOYEE)

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  employee   Employee? @relation(fields: [employeeId], references: [id])
  employeeId String?   @unique

  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  activityLogs            ActivityLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Department {
  id          String  @id @default(uuid())
  name        String
  description String?

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  employees Employee[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Employee {
  id         String         @id @default(uuid())
  employeeId String // Internal ID like EMP001
  firstName  String
  lastName   String
  email      String
  phone      String?
  status     EmployeeStatus @default(ACTIVE)
  hireDate   DateTime

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  user User?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payslips Payslip[]
  leaves   Leave[]

  baseSalary Float @default(0.0)
  allowances Float @default(0.0)
  deductions Float @default(0.0)

  @@unique([tenantId, employeeId])
  @@unique([tenantId, email])
}

model Invoice {
  id            String        @id @default(uuid())
  invoiceNumber String // e.g. INV-2024-001
  status        InvoiceStatus @default(DRAFT)
  issueDate     DateTime
  dueDate       DateTime

  currency     String @default("INR")
  exchangeRate Float  @default(1.0)

  subTotal    Float
  taxTotal    Float
  totalAmount Float
  amountPaid  Float @default(0.0)

  clientName    String
  clientEmail   String?
  clientAddress String?

  notes String?

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  items InvoiceItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, invoiceNumber])
}

model InvoiceItem {
  id          String @id @default(uuid())
  description String
  quantity    Float
  unitPrice   Float
  taxRate     Float  @default(0.0)
  amount      Float

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Transaction {
  id          String          @id @default(uuid())
  date        DateTime
  description String
  amount      Float
  type        TransactionType
  category    String

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Notification {
  id      String           @id @default(uuid())
  type    NotificationType @default(INFO)
  title   String
  message String
  read    Boolean          @default(false)
  link    String?

  userId String
  user   User   @relation(fields: [userId], references: [id])

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  deliveries NotificationDelivery[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model NotificationPreference {
  id        String              @id @default(uuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id])
  eventType String // e.g. "INVOICE_OVERDUE", "PAYROLL_COMPLETED"
  channel   NotificationChannel
  enabled   Boolean             @default(true)
  tenantId  String

  @@unique([userId, eventType, channel])
}

model NotificationDelivery {
  id             String              @id @default(uuid())
  notificationId String
  notification   Notification        @relation(fields: [notificationId], references: [id])
  channel        NotificationChannel
  status         DeliveryStatus      @default(PENDING)
  attempts       Int                 @default(0)
  lastError      String?
  deliveredAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WebhookSubscription {
  id         String   @id @default(uuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  url        String
  secret     String // HMAC signing secret
  eventTypes String[] // Array of event type strings
  isActive   Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ActivityLog {
  id         String  @id @default(uuid())
  action     String // e.g. INVOICE_CREATED
  entityType String // e.g. INVOICE
  entityId   String?
  details    Json? // Store metadata

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  createdAt DateTime @default(now())
}

model Vendor {
  id      String  @id @default(uuid())
  name    String
  code    String?
  email   String?
  phone   String?
  address String?

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  products       Product[]
  purchaseOrders PurchaseOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, code])
}

model Warehouse {
  id        String  @id @default(uuid())
  name      String
  location  String?
  isDefault Boolean @default(false)

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  stockMovements StockMovement[]
  purchaseOrders PurchaseOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id          String  @id @default(uuid())
  sku         String
  name        String
  description String?
  category    String?
  unit        String  @default("pcs")
  price       Float   @default(0)

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  vendorId String?
  vendor   Vendor? @relation(fields: [vendorId], references: [id])

  stockMovements     StockMovement[]
  purchaseOrderItems PurchaseOrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reorderLevel Float @default(0.0)

  @@unique([tenantId, sku])
}

model StockMovement {
  id        String            @id @default(uuid())
  type      StockMovementType
  quantity  Float
  reference String? // PO number, Invoice number, etc.
  reason    String?

  productId String
  product   Product @relation(fields: [productId], references: [id])

  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

  userId String?

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  createdAt DateTime @default(now())
}

model PurchaseOrder {
  id           String              @id @default(uuid())
  poNumber     String // e.g. PO-2024-001
  status       PurchaseOrderStatus @default(DRAFT)
  orderDate    DateTime
  expectedDate DateTime?

  totalAmount Float
  notes       String?

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  vendorId String
  vendor   Vendor @relation(fields: [vendorId], references: [id])

  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

  items PurchaseOrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, poNumber])
}

model PurchaseOrderItem {
  id         String @id @default(uuid())
  quantity   Float
  unitPrice  Float
  totalPrice Float

  productId String
  product   Product @relation(fields: [productId], references: [id])

  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PayrollRun {
  id          String        @id @default(uuid())
  periodStart DateTime
  periodEnd   DateTime
  status      PayrollStatus @default(DRAFT)
  totalAmount Float

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  payslips Payslip[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Payslip {
  id         String   @id @default(uuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])

  payrollRunId String
  payrollRun   PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)

  basicSalary Float
  allowances  Float @default(0.0)
  deductions  Float @default(0.0)
  netSalary   Float

  paidAt DateTime?
  status PayslipStatus @default(PENDING)

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum JournalEntryStatus {
  DRAFT
  POSTED
}

enum AccountingPeriodStatus {
  OPEN
  CLOSED
}

enum LeaveType {
  PAID
  UNPAID
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

model Account {
  id        String      @id @default(uuid())
  code      String      // Unique within tenant, e.g. "1000", "2000"
  name      String
  type      AccountType
  balance   Float       @default(0.0)

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  journalLines JournalLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, code])
}

model JournalEntry {
  id          String             @id @default(uuid())
  date        DateTime
  description String
  status      JournalEntryStatus @default(DRAFT)

  periodId String
  period   AccountingPeriod @relation(fields: [periodId], references: [id])

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  lines JournalLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model JournalLine {
  id             String       @id @default(uuid())
  debit          Float        @default(0.0)
  credit         Float        @default(0.0)

  journalEntryId String
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)

  accountId String
  account   Account @relation(fields: [accountId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AccountingPeriod {
  id        String                 @id @default(uuid())
  name      String                 // e.g. "Q1-2024", "Jan-2024"
  startDate DateTime
  endDate   DateTime
  status    AccountingPeriodStatus @default(OPEN)

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  entries JournalEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Leave {
  id        String      @id @default(uuid())
  startDate DateTime
  endDate   DateTime
  type      LeaveType
  status    LeaveStatus @default(PENDING)
  reason    String?

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
