datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  HR
  FINANCE
  MANAGER
  EMPLOYEE
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
  TERMINATED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  PARTIALLY_PAID
  OVERDUE
  CANCELLED
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
  SYSTEM
}

enum StockMovementType {
  IN
  OUT
  ADJUSTMENT
  TRANSFER
}

model Tenant {
  id          String   @id @default(uuid())
  name        String
  domain      String?  @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  users       User[]
  employees   Employee[]
  departments Department[]
  invoices    Invoice[]
  transactions Transaction[]
  
  notifications Notification[]
  activityLogs   ActivityLog[]
  
  vendors       Vendor[]
  warehouses    Warehouse[]
  products      Product[]
  stockMovements StockMovement[]
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String?
  role      Role     @default(EMPLOYEE)
  
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  
  employee  Employee? @relation(fields: [employeeId], references: [id])
  employeeId String?  @unique

  notifications Notification[]
  activityLogs  ActivityLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Department {
  id          String   @id @default(uuid())
  name        String
  description String?
  
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  
  employees   Employee[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Employee {
  id            String         @id @default(uuid())
  employeeId    String         // Internal ID like EMP001
  firstName     String
  lastName      String
  email         String
  phone         String?
  status        EmployeeStatus @default(ACTIVE)
  hireDate      DateTime
  
  tenantId      String
  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  
  departmentId  String?
  department    Department?    @relation(fields: [departmentId], references: [id])
  
  user          User?
  
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([tenantId, employeeId])
  @@unique([tenantId, email])
}

model Invoice {
  id            String        @id @default(uuid())
  invoiceNumber String        // e.g. INV-2024-001
  status        InvoiceStatus @default(DRAFT)
  issueDate     DateTime
  dueDate       DateTime
  
  currency      String        @default("INR")
  exchangeRate  Float         @default(1.0)
  
  subTotal      Float
  taxTotal      Float
  totalAmount   Float
  amountPaid    Float         @default(0.0)
  
  clientName    String
  clientEmail   String?
  clientAddress String?
  
  notes         String?
  
  tenantId      String
  tenant        Tenant        @relation(fields: [tenantId], references: [id])
  
  items         InvoiceItem[]
  
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@unique([tenantId, invoiceNumber])
}

model InvoiceItem {
  id          String   @id @default(uuid())
  description String
  quantity    Float
  unitPrice   Float
  taxRate     Float    @default(0.0)
  amount      Float
  
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Transaction {
  id            String          @id @default(uuid())
  date          DateTime
  description   String
  amount        Float
  type          TransactionType
  category      String
  
  tenantId      String
  tenant        Tenant          @relation(fields: [tenantId], references: [id])
  
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

model Notification {
  id          String           @id @default(uuid())
  type        NotificationType @default(INFO)
  title       String
  message     String
  read        Boolean          @default(false)
  link        String?
  
  userId      String
  user        User             @relation(fields: [userId], references: [id])
  
  tenantId    String
  tenant      Tenant           @relation(fields: [tenantId], references: [id])
  
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model ActivityLog {
  id          String   @id @default(uuid())
  action      String   // e.g. INVOICE_CREATED
  entityType  String   // e.g. INVOICE
  entityId    String?
  details     Json?    // Store metadata
  
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  
  createdAt   DateTime @default(now())
}

model Vendor {
  id          String   @id @default(uuid())
  name        String
  code        String?
  email       String?
  phone       String?
  address     String?
  
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  
  products    Product[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, code])
}

model Warehouse {
  id          String   @id @default(uuid())
  name        String
  location    String?
  isDefault   Boolean  @default(false)
  
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  
  stockMovements StockMovement[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Product {
  id          String   @id @default(uuid())
  sku         String
  name        String
  description String?
  category    String?
  unit        String   @default("pcs")
  price       Float    @default(0)
  
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  
  vendorId    String?
  vendor      Vendor?  @relation(fields: [vendorId], references: [id])
  
  stockMovements StockMovement[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, sku])
}

model StockMovement {
  id          String            @id @default(uuid())
  type        StockMovementType
  quantity    Float
  reference   String?           // PO number, Invoice number, etc.
  reason      String?
  
  productId   String
  product     Product           @relation(fields: [productId], references: [id])
  
  warehouseId String
  warehouse   Warehouse         @relation(fields: [warehouseId], references: [id])
  
  userId      String?
  
  tenantId    String
  tenant      Tenant            @relation(fields: [tenantId], references: [id])
  
  createdAt   DateTime          @default(now())
}
